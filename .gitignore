.claude/settings.local.json

# 로컬 핸드오프 노트 (커밋 X)
/handoff/

# OG 카드는 생성물. 정본은 generate_og_cards.py 와 Storage(share_cards/og/).
marketing/og_t*.jpg
marketing/.cache_og/

# ── 생성물은 추적하지 않는다 (정본 = 생성기 스크립트) ──────────────
# marketing/ 의 이미지는 generate_*.py 로 언제든 다시 굽는다.
# 광고 소재를 v3, v4... 로 돌릴 때마다 리포가 부풀던 문제.
marketing/**/*.png
marketing/**/*.jpg
marketing/**/*.jpeg
marketing/**/*.gif
marketing/**/*.webp
marketing/.cache_og/
marketing/_*.html

# 디자인 프리뷰 렌더 결과(소스 html은 추적).
docs/design/previews/*.png

# wrangler 로컬 빌드 캐시.
workers/share-landing/.wrangler/
